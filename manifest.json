{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/bilibili-16.png",
    "32": "icons/bilibili-32.png",
    "128": "icons/bilibili-128.png"
  },
  "permissions": ["storage", "offscreen", "alarms", "cookies", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.hdslb.com/*",
    "https://*.akamaized.net/*",
    "https://*.mountaintoys.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "bilibili_media_referer",
      "enabled": true,
      "path": "rules/bilibili-media-referer.json"
    }]
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/bilibili-16.png",
      "32": "icons/bilibili-32.png",
      "128": "icons/bilibili-128.png"
    },
    "default_popup": "popup/popup.html"
  }
}
